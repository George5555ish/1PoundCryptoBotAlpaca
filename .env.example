# Paper trading only. ALPACA_PAPER must stay true.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# OpenAI. Used by the crypto suggestion path. --multi-strategy does not call the model.
# Create a key at https://platform.openai.com/api-keys (starts with sk-).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

LOOP_INTERVAL_SECONDS=300

# Multi-strategy tester is a CLI flag, not an env switch:
#   python main.py --once --multi-strategy
# Add GLD, SLV, USO in config.MULTI_STRATEGY_SYMBOLS when commodities should be scanned.

# Optional. Display-only conversion for the £1 note. Never used for sizing.
POUNDS_PER_USD=

# Where decisions.db, bot.log, and charts are written. Local default is ./data.
# On Railway, mount a volume at /data and set this to /data. A blank value
# writes inside the container and is wiped on the next deploy.
DATA_DIR=

# Optional. n8n webhook that receives each logged decision as JSON for Google Sheets.
# A submitted entry or close sets event_type to trade_opened or trade_closed.
# Leave blank to skip the notification. A failed call does not stop the bot.
N8N_WEBHOOK_URL=

# Optional email when a paper order is submitted. Both the address and SMTP_HOST
# are required before a message is sent. A missing or failed mail does not stop the bot.
TRADE_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional dashboard. The process serves GET / on PORT (Railway sets this).
# Last-five trades are read from this webhook. Leave blank to use the default.
# DASHBOARD_TRADES_WEBHOOK=
# DASHBOARD_PORT=8080
