# Paper trading only. ALPACA_PAPER must stay true.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Grok, through the OpenAI-compatible client. The variable name is historical.
# The secret comes from https://console.x.ai and starts with xai-
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.x.ai/v1
OPENAI_MODEL=grok-4.7

LOOP_INTERVAL_SECONDS=60

# Optional. Display-only conversion for the £1 note. Never used for sizing.
POUNDS_PER_USD=

# Where decisions.db, bot.log, and charts are written. Local default is ./data.
# On Railway, mount a volume at /data and set this to /data. A blank value
# writes inside the container and is wiped on the next deploy.
DATA_DIR=

# Optional. n8n webhook that receives each logged decision as JSON for Google Sheets.
# A submitted entry or close sets event_type to trade_opened or trade_closed.
# Leave blank to skip the notification. A failed call does not stop the bot.
N8N_WEBHOOK_URL=

# Optional email when a paper order is submitted. Both the address and SMTP_HOST
# are required before a message is sent. A missing or failed mail does not stop the bot.
TRADE_NOTIFY_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
